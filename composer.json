{
    "name": "krugerdavid/laravel-bancard",
    "description": "Laravel integration for Bancard VPOS 2.0 (Single Buy, Cards, Charge)",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "krugerdavid",
        "laravel",
        "bancard",
        "vpos",
        "payments",
        "paraguay"
    ],
    "authors": [
        {
            "name": "David Kruger",
            "email": "me@krugerdavid.com",
            "homepage": "https://krugerdavid.com",
            "role": "Fullstack Engineer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "pestphp/pest": "^2.0|^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0|^4.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "KrugerDavid\\Bancard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KrugerDavid\\Bancard\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "KrugerDavid\\Bancard\\BancardServiceProvider"
            ],
            "aliases": {
                "Bancard": "KrugerDavid\\Bancard\\Facades\\Bancard"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
